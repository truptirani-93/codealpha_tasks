import java.util.*;

public class StockTradingPlatform {
    static class Stock {
        String symbol;
        double price;

        Stock(String symbol, double price) {
            this.symbol = symbol;
            this.price = price;
        }

        void updatePrice() {
            double change = (Math.random() - 0.5) * 10; // ±$5 fluctuation
            price = Math.round((price + change) * 100.0) / 100.0;
        }

        public String toString() {
            return symbol + ": $" + price;
        }
    }

    static class Portfolio {
        double cash;
        Map<String, Integer> holdings;

        Portfolio(double cash) {
            this.cash = cash;
            this.holdings = new HashMap<>();
        }

        void buy(Stock stock, int quantity) {
            double totalCost = stock.price * quantity;
            if (cash >= totalCost) {
                cash -= totalCost;
                holdings.put(stock.symbol, holdings.getOrDefault(stock.symbol, 0) + quantity);
                System.out.println("Bought " + quantity + " shares of " + stock.symbol);
            } else {
                System.out.println("Not enough cash to complete the purchase.");
            }
        }

        void sell(Stock stock, int quantity) {
            int owned = holdings.getOrDefault(stock.symbol, 0);
            if (owned >= quantity) {
                holdings.put(stock.symbol, owned - quantity);
                cash += stock.price * quantity;
                System.out.println("Sold " + quantity + " shares of " + stock.symbol);
            } else {
                System.out.println("Not enough shares to sell.");
            }
        }

        void show(Market market) {
            System.out.println("----- Portfolio -----");
            System.out.println("Cash: $" + Math.round(cash * 100.0) / 100.0);
            double totalValue = cash;
            for (String symbol : holdings.keySet()) {
                int qty = holdings.get(symbol);
                double price = market.getPrice(symbol);
                double value = qty * price;
                System.out.println(symbol + ": " + qty + " shares ($" + value + ")");
                totalValue += value;
            }
            System.out.println("Total Portfolio Value: $" + Math.round(totalValue * 100.0) / 100.0);
        }
    }

    static class Market {
        Map<String, Stock> stocks;

        Market() {
            stocks = new HashMap<>();
            stocks.put("AAPL", new Stock("AAPL", 150.00));
            stocks.put("GOOG", new Stock("GOOG", 2800.00));
            stocks.put("TSLA", new Stock("TSLA", 700.00));
        }

        void updatePrices() {
            for (Stock stock : stocks.values()) {
                stock.updatePrice();
            }
        }

        void showPrices() {
            System.out.println("----- Market Prices -----");
            for (Stock stock : stocks.values()) {
                System.out.println(stock);
            }
        }

        Stock getStock(String symbol) {
            return stocks.get(symbol);
        }

        double getPrice(String symbol) {
            return stocks.get(symbol).price;
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Market market = new Market();
        Portfolio portfolio = new Portfolio(10000); // Starting with $10,000

        while (true) {
            market.updatePrices();
            market.showPrices();
            portfolio.show(market);

            System.out.println("\nEnter command (buy/sell/exit): ");
            String cmd = scanner.nextLine().trim().toLowerCase();

            if (cmd.equals("exit")) {
                System.out.println("Exiting simulation. Goodbye!");
                break;
            }

            System.out.print("Enter stock symbol (AAPL, GOOG, TSLA): ");
            String symbol = scanner.nextLine().trim().toUpperCase();

            Stock stock = market.getStock(symbol);
            if (stock == null) {
                System.out.println("Invalid stock symbol.");
                continue;
            }

            System.out.print("Enter quantity: ");
            int quantity;
            try {
                quantity = Integer.parseInt(scanner.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.println("Invalid quantity.");
                continue;
            }

            if (cmd.equals("buy")) {
                portfolio.buy(stock, quantity);
            } else if (cmd.equals("sell")) {
                portfolio.sell(stock, quantity);
            } else {
                System.out.println("Invalid command.");
            }
        }

        scanner.close();
    }
}
